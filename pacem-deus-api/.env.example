# ═══════════════════════════════════════════════════════════════
# Pacem Deus Bodas — Variables de entorno (TEMPLATE)
# IS276 — Plataformas Móviles y Análisis Cloud — Grupo 2
# ═══════════════════════════════════════════════════════════════
# Instrucciones:
#   1. Copie este archivo como .env en la misma carpeta (pacem-deus-api/.env)
#   2. Complete los valores con sus credenciales locales
#   3. NUNCA agregue el archivo .env al control de versiones
#      (ya está excluido en el .gitignore de la raíz del repo)
# ═══════════════════════════════════════════════════════════════

# ─── Base de datos PostgreSQL ──────────────────────────────────
# Cada desarrollador usa su propia instancia local de PostgreSQL.
# Estos valores corresponden a la configuración por defecto del instalador oficial.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=pacem_deus_android
DB_USER=postgres
DB_PASSWORD=reemplazar-con-su-password-local

# ─── Seguridad JWT ─────────────────────────────────────────────
# Clave usada para firmar los tokens de autenticación.
# En desarrollo cualquier cadena larga sirve; en producción debe ser secreta.

JWT_SECRET=pacem-deus-dev-secret-change-in-prod
